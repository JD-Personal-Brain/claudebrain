{
  "permissions": {
    "allow": ["Artifact", "ArtifactComments", "ArtifactData"]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__github__merge_pull_request",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-merge-check.sh", "timeout": 300 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/reply-length.py", "timeout": 30 } ] }
    ]
  }
}
